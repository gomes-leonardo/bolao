    "test": "vitest run",
    "test:integration": "vitest run --config ./vitest.config.integration.ts"
  },
  "dependencies": {
    "@bolao/core": "*",
    "@nestjs/common": "12.1.2",
    "@nestjs/core": "12.1.2",
    "@nestjs/platform-express": "12.1.2",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.8",
    "@nestjs/schematics": "12.0.0",
    "@nestjs/testing": "12.1.2",
    "@swc/cli": "0.8.1",
    "@swc/core": "1.16.13",
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "typescript": "6.0.2",
    "unplugin-swc": "2.0.0",
    "vitest": "5.0.3",
    "vitest-mock-extended": "5.1.1"
  }
