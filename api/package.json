{
  "name": "@bolao/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node --env-file-if-exists=.env dist/main.js",
