PORT=3333
DATABASE_URL=postgresql://bolao:bolao@localhost:5433/bolao
CURRENT_SEASON=2026
WEB_ORIGIN=http://localhost:5174

# Segredo do access token JWT (HS256, no mínimo 32 caracteres). Sem ele a API não sobe.
# Troque por um valor aleatório em produção.
JWT_ACCESS_SECRET=dev-secret-troque-em-producao-1234567890

# Custo do bcrypt. 12 em produção; os testes de integração usam 4.
BCRYPT_ROUNDS=12

# Em desenvolvimento, o header X-Dev-User-Id continua aceito (só com AUTH_MODE=dev),
# como atalho para o login por e-mail e senha.
AUTH_MODE=dev
