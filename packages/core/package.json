{
  "name": "@bolao/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "generate": "prisma generate",
    "migrate": "prisma migrate dev && prisma generate",
    "migrate:new": "prisma migrate dev --create-only --name",
    "migrate:reset": "prisma migrate reset --force",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "dotenv": "18.0.5",
    "pg": "8.23.1",
    "prisma": "7.10.0",
    "typescript": "6.0.2"
  }
}
