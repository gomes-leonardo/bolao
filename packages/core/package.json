{
  "name": "@bolao/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./contracts": "./src/contracts/index.ts",
    "./scoring": "./src/scoring/score-prediction.ts",
    "./prisma": "./src/prisma.ts",
    "./testing": "./src/test/index.ts",
    "./testing/global-setup": "./src/test/integration-db.ts"
  },
  "scripts": {
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev && prisma generate",
    "db:migrate:new": "prisma migrate dev --create-only --name",
    "db:reset": "prisma migrate reset --force",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:integration": "vitest run --config ./vitest.config.integration.ts",
    "db:seed": "node scripts/seed-dev.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "dotenv": "18.0.5",
    "pg": "8.23.1",
    "prisma": "7.10.0",
    "typescript": "6.0.2",
    "vitest": "5.0.3"
  }
}
