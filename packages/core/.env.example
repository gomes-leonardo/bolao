# Banco de desenvolvimento (docker compose expõe na 5433)
DATABASE_URL=postgresql://bolao:bolao@localhost:5433/bolao

# Banco dos testes de integração: é criado e apagado a cada execução.
# Nunca aponte para o banco de desenvolvimento.
TEST_DATABASE_URL=postgresql://bolao:bolao@localhost:5433/bolao_integration_test
